{
  "name": "jnf-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "jnf-harness 桌面壳：Tauri 2 托管内嵌 Spring Boot 服务，React 前端只经 127.0.0.1 HTTP/SSE 调用",
  "scripts": {
    "dev": "tauri dev",
    "build": "npm run agent:verify && tauri build",
    "tauri": "tauri",
    "web:dev": "vite",
    "web:build": "tsc && vite build",
    "web:preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/generate-icons.mjs",
    "agent:build": "mvn -f ../jnf-harness/pom.xml -DskipTests package",
    "agent:copy": "node scripts/copy-agent-jar.mjs",
    "agent:runtime": "node scripts/prepare-runtime.mjs",
    "agent:prepare": "npm run agent:build && npm run agent:copy && npm run agent:runtime",
    "agent:verify": "node scripts/copy-agent-jar.mjs --verify"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-http": "^2.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
